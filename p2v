#!/usr/bin/env bash
# doc2course command line (forked from paper2video). One entry point for every step; works from any directory.
#
#   p2v setup                 install tools (Node packages, ffmpeg, headless Chromium, Python venv, voice model)
#   p2v doctor                show folders and what is installed
#   p2v fetch <source> [--job ID] [--type slides|paper|document] [--figures own|unknown]
#                             source = arXiv link/id, a local PDF (lecture slides, handouts, papers) or a PDF link
#   p2v check <job>           mechanical claims check (must end FAIL 0, WARN 0)
#   p2v tts <job> [opts]      narration + timing (opts: --engine, --voice, --speed, --no-cache)
#   p2v preview <job> [--scenes a,b]   contact sheets at every sentence midpoint (optionally only some scenes)
#   p2v render <job> [--manual|--allow-stale] [--workers N] [--gpu auto|cpu|metal|vulkan|egl] [--gpu-device D]
#   p2v scenes <job> --scenes a,b --file scenes_x.js [--brief]   one chapter's scene code in a fresh agent (small context)
#   p2v api [words]           compact engine reference (signatures + comments; read this, not the engine source)
#   p2v verify <job> [--agent claude|codex] [--scenes a,b] [--full] [--brief]   independent verifier in a fresh agent process -> VERIFY*.md
#                             round 1 checks everything; later rounds re-check open findings + changed scenes only;
#                             --brief prints the verifier prompt for a subagent instead of starting a process
#   p2v gpus                  GPUs the renderer can use (pick one with --gpu-device or P2V_GPU_DEVICE)
#   p2v collect               re-link every finished video into the videos folder
#   p2v smoke [--ko]          end-to-end toolchain test
#   p2v test                  fast regression tests (no tools or network needed)
#   p2v run [--agent claude|codex] <source> [overrides]   unattended run (log in <work>/logs/)
#   p2v paths                 print the resolved folders as export lines
#
# Folders (details in scripts/p2v_paths.py): code stays in the skill folder, tools in P2V_TOOLS,
# jobs and videos in P2V_HOME (~/doc2course for installed copies). All four can be overridden by env vars.
# Agents: P2V_AGENT (claude|codex) picks the CLI for verify/scenes/run; P2V_CODEX_ARGS overrides the codex exec flags
# (default: --full-auto --skip-git-repo-check).
set -euo pipefail
# Logical path (symlinked skill folders keep their ~/.claude/skills/... spelling, which is what permission rules see).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYSPY="$(command -v python3 || true)"
[ -n "$SYSPY" ] || { echo "p2v: python3 not found (need Python 3.10-3.13)"; exit 1; }
# Remember whether the user chose the videos folder themselves: an explicit P2V_OUT beats "next to the source PDF".
export P2V_OUT_EXPLICIT="${P2V_OUT:+1}"
eval "$("$SYSPY" "$ROOT/scripts/p2v_paths.py" --shell)"
PY="$P2V_TOOLS/.venv/bin/python"
# Keep every download next to the tools (not in ~/Library/Caches or ~/.cache), so the whole install lives on one disk:
# headless Chromium, the Supertonic model (Hugging Face cache), and the npm/pip download caches.
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$P2V_TOOLS/ms-playwright}"
export HF_HOME="${HF_HOME:-$P2V_TOOLS/huggingface}"
export npm_config_cache="${npm_config_cache:-$P2V_TOOLS/.npm-cache}"
export PIP_CACHE_DIR="${PIP_CACHE_DIR:-$P2V_TOOLS/.pip-cache}"

need_tools() {
  [ -x "$PY" ] && [ -d "$P2V_TOOLS/node_modules/three" ] && return 0
  echo "p2v: tools are not installed yet ($P2V_TOOLS). Run: $ROOT/p2v setup"; exit 3
}
need_job() {
  [ -n "${1:-}" ] || { echo "usage: p2v $CMD <job>"; exit 2; }
  [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { echo "p2v: '$1' is not a job id (letters, digits, . _ - only)"; exit 2; }
  seed_job "$1"
  [ -d "$P2V_JOBS/$1" ] || { echo "p2v: no job '$1' in $P2V_JOBS (run: p2v fetch <arxiv link | file.pdf> first)"; exit 2; }
}
# Bundled example jobs (2610.30340, _smoke, _smoke_ko) ship inside the skill folder.
# Copy one into the work dir the first time it is used, so builds never write into the skill folder.
seed_job() {
  local j="$1"
  [ -d "$P2V_JOBS/$j" ] || [ ! -d "$ROOT/jobs/$j" ] && return 0
  mkdir -p "$P2V_JOBS" && cp -R "$ROOT/jobs/$j" "$P2V_JOBS/$j" && rm -rf "$P2V_JOBS/$j/build"
}

# macOS: files downloaded by a quarantine-aware parent (some sandboxes, GUI apps) carry com.apple.quarantine,
# and the first dlopen/exec of them is refused or killed. Clear it right after each install step, before use.
unquarantine() { [ "$(uname)" = "Darwin" ] || return 0; local d; for d in "$@"; do [ -e "$d" ] && xattr -dr com.apple.quarantine "$d" 2>/dev/null; done; return 0; }

pick_python() {   # kokoro-onnx needs Python 3.10-3.13 (no 3.14 wheels yet)
  local c v
  for c in "${PYTHON:-}" python3.13 python3.12 python3.11 python3.10 \
           /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3.11 \
           /usr/local/bin/python3.13 /usr/local/bin/python3.12 /usr/local/bin/python3.11 \
           /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 \
           /Library/Frameworks/Python.framework/Versions/3.12/bin/python3 python3; do
    [ -n "$c" ] || continue
    command -v "$c" >/dev/null 2>&1 || [ -x "$c" ] || continue
    v=$("$c" -c 'import sys; print("%d%02d" % sys.version_info[:2])' 2>/dev/null) || continue
    if [ "$v" -ge 310 ] && [ "$v" -le 313 ]; then
      # If $c is itself inside a venv, build from its base interpreter (nested venvs can break).
      local b; b=$("$c" -c 'import os,sys; print(os.path.join(sys.base_prefix,"bin","python%d.%d" % sys.version_info[:2]))' 2>/dev/null)
      if [ -n "$b" ] && [ -x "$b" ]; then echo "$b"; else echo "$c"; fi; return 0
    fi
  done
  return 1
}

setup() {
  local T="$P2V_TOOLS"
  echo "== tools folder: $T"
  mkdir -p "$T"
  command -v node >/dev/null || { echo "!! Node 18+ is required (brew install node)"; exit 1; }
  [ "$(node -p 'process.versions.node.split(".")[0]')" -ge 18 ] || { echo "!! Node 18+ is required (found $(node -v))"; exit 1; }
  command -v npm >/dev/null || { echo "!! npm is required (it ships with Node)"; exit 1; }
  echo "== node packages (three, ffmpeg-static, playwright)"
  if cmp -s "$ROOT/tools/package-lock.json" "$T/package-lock.json" && [ -d "$T/node_modules/three" ]; then
    echo "already installed"
  else
    cp "$ROOT/tools/package.json" "$ROOT/tools/package-lock.json" "$T/"
    (cd "$T" && npm ci --no-fund --no-audit --loglevel=error) || { rm -f "$T/package-lock.json"; exit 1; }
  fi
  [ -x "$T/node_modules/ffmpeg-static/ffmpeg" ] || (cd "$T" && node node_modules/ffmpeg-static/install.js)
  unquarantine "$T/node_modules"
  (cd "$T" && npx --yes playwright install chromium) || echo "!! Chromium install failed: render with 'p2v render <job> --manual' in any browser"
  unquarantine "$PLAYWRIGHT_BROWSERS_PATH"
  echo "== python venv"
  local P; P=$(pick_python) || { echo "!! Need Python 3.10-3.13 (brew install python@3.12, or set PYTHON=/path/to/python3.12)"; exit 1; }
  echo "using $P ($("$P" -V))"
  if [ -x "$T/.venv/bin/python" ]; then
    local vv; vv=$("$T/.venv/bin/python" -c 'import sys; print("%d%02d" % sys.version_info[:2])' 2>/dev/null || echo 0)
    if [ "$vv" -lt 310 ] || [ "$vv" -gt 313 ]; then echo "rebuilding .venv (was $vv)"; rm -rf "$T/.venv"; fi
  fi
  [ -x "$T/.venv/bin/python" ] || "$P" -m venv "$T/.venv"
  "$T/.venv/bin/pip" install -q --upgrade pip
  "$T/.venv/bin/pip" install -q -r "$ROOT/requirements.txt"
  unquarantine "$T/.venv"
  echo "== Kokoro voice model (~350 MB, once)"
  "$T/.venv/bin/python" "$ROOT/scripts/tts.py" --download-models   # verifies size + SHA-256
  unquarantine "$T/models"
  command -v pdftotext >/dev/null || echo "note: pdftotext not found (brew install poppler); fetch falls back to pypdf"
  doctor
  echo "setup done. Optional toolchain test: $ROOT/p2v smoke"
}

doctor() {
  echo "skill   $P2V_ROOT"
  echo "tools   $P2V_TOOLS"
  echo "jobs    $P2V_JOBS"
  echo "videos  $P2V_OUT"
  echo "caches  $PLAYWRIGHT_BROWSERS_PATH, $HF_HOME"
  local ok=1
  if [ -x "$PY" ] && "$PY" -c "import kokoro_onnx, soundfile, pypdf, pypdfium2, PIL, supertonic" 2>/dev/null; then echo "python  ok ($("$PY" -V))"; else echo "python  missing (or outdated: run setup again)"; ok=0; fi
  if [ -s "$P2V_TOOLS/models/kokoro-v1.0.onnx" ]; then echo "voice   ok"; else echo "voice   missing"; ok=0; fi
  command -v node >/dev/null || { echo "node    missing (install Node 18+)"; return 1; }
  local ff
  if ff=$(cd "$ROOT" && node -e "import('./scripts/lib.mjs').then(m=>console.log(m.resolveFfmpeg(process.env.P2V_ROOT)))" 2>/dev/null); then
    echo "ffmpeg  ok ($ff)"
  else
    echo "ffmpeg  missing"; ok=0
  fi
  [ -d "$P2V_TOOLS/node_modules/playwright" ] && echo "render  ok (playwright)" || echo "render  manual only (no playwright)"
  local a; for a in claude codex; do command -v "$a" >/dev/null && echo "agent   $a ($(command -v "$a"))"; done
  [ $ok = 1 ] || { echo "-> run: $ROOT/p2v setup"; return 1; }
}

smoke() {
  need_tools
  for j in _smoke _smoke_ko 2610.30340; do seed_job "$j"; done
  echo "== 1/4 python deps"; "$PY" -c "import numpy, kokoro_onnx, soundfile, pypdf, supertonic" && echo ok
  echo "== 2/4 kokoro tts";   "$PY" "$ROOT/scripts/tts.py" _smoke --engine kokoro
  echo "== 3/4 render";       node "$ROOT/scripts/render.mjs" _smoke
  echo "== 4/4 claims check"; "$PY" "$ROOT/scripts/check_claims.py" 2610.30340
  if [ "${1:-}" = "--ko" ]; then
    echo "== ko 1/2 supertonic tts (first run downloads the model)"; "$PY" "$ROOT/scripts/tts.py" _smoke_ko
    echo "== ko 2/2 render"; node "$ROOT/scripts/render.mjs" _smoke_ko
  fi
  echo "ALL PASS -> $P2V_JOBS/_smoke/build/_smoke.mp4"
}

pick_agent() {   # --agent X, else $P2V_AGENT, else whichever CLI exists (claude first)
  local a="${P2V_AGENT:-}"
  if [ -z "$a" ]; then for a in claude codex; do command -v "$a" >/dev/null && break; a=""; done; fi
  [ -n "$a" ] || { echo "p2v: neither claude nor codex is on PATH (or set P2V_AGENT)" >&2; return 1; }
  case "$a" in claude|codex) ;; *) echo "p2v: unknown agent '$a' (claude or codex)" >&2; return 1 ;; esac
  command -v "$a" >/dev/null || { echo "p2v: '$a' CLI not found on PATH" >&2; return 1; }
  echo "$a"
}

# Run a prompt in a fresh agent process (no shared context with the caller). $1 agent, $2 work dir, $3 prompt, $4 log file.
agent_exec() {
  local agent="$1" dir="$2" prompt="$3" log="$4"
  if [ "$agent" = claude ]; then
    (cd "$dir" && claude -p "$prompt" --permission-mode acceptEdits \
      --allowedTools "Bash($ROOT/p2v *),Bash($(cd "$ROOT" && pwd -P)/p2v *),Bash(ls *),Bash(cat *),Bash(head *),Bash(wc *),Bash(grep *),Read,Write,Edit,Glob,Grep,Task,Agent" \
      --add-dir "$ROOT" --add-dir "$P2V_HOME" --output-format json > "$log")
    "$SYSPY" -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('result','')); sys.exit(1 if d.get('is_error') else 0)" "$log"
  else
    # shellcheck disable=SC2086
    (cd "$dir" && codex exec ${P2V_CODEX_ARGS:---full-auto --skip-git-repo-check} -C "$dir" "$prompt" 2>&1 | tee "$log")
  fi
}

verify() {
  need_tools
  local agent="" scenes="" job="" full="" brief=""
  while [ $# -gt 0 ]; do case "$1" in
    --agent) agent="${2:-}"; shift 2 ;; --scenes) scenes="${2:-}"; shift 2 ;; --full) full=--full; shift ;;
    --brief) brief=1; shift ;; *) job="$1"; shift ;; esac; done
  need_job "$job"
  local J="$P2V_JOBS/$job" scope="the whole video"
  [ -n "$scenes" ] && scope="only these scenes of script.json: $scenes (one part of a long video)"
  "$PY" "$ROOT/scripts/check_claims.py" "$job" >/dev/null || true   # fresh build/VERIFY_auto.md for the verifier
  # Round 1 is a full check; later rounds re-check only open findings and what changed (scripts/verify_scope.py).
  local info; info=$("$PY" "$ROOT/scripts/verify_scope.py" "$job" ${scenes:+--scenes "$scenes"} $full) || exit 1
  local get="import json,sys; d=json.loads(sys.argv[1]); print(d[sys.argv[2]] or '')"
  local round mode out delta prev
  round=$("$SYSPY" -c "$get" "$info" round); mode=$("$SYSPY" -c "$get" "$info" mode); out=$("$SYSPY" -c "$get" "$info" out)
  delta=$("$SYSPY" -c "$get" "$info" delta); prev=$("$SYSPY" -c "$get" "$info" previous)
  local prompt
  if [ "$mode" = full ]; then
    prompt="You are the independent verifier for the doc2course job in $J. You did not write it; judge it.
Follow $ROOT/references/verification.md exactly (all layers that apply to the document type in paper/meta.json).
Scope: $scope.
Read only: paper/paper.txt, paper/transcribed.txt (if present), paper/meta.json, paper/pages/*.jpg (to check transcriptions and slide content), script.json, claims.json, BRIEF.md, the job's .js scene files, build/VERIFY_auto.md, build/onscreen.json and build/preview_*.jpg (look at the images).
You may run: $ROOT/p2v check $job
Write your report to $J/$out in the format given in verification.md, starting with 'round: 1 (full)' and ending with 'overall: PASS', 'overall: FIX-AND-RERUN' or 'overall: BLOCKED'. Do not edit any other file."
  else
    prompt="You are the independent verifier for the doc2course job in $J (re-check, round $round). You did not write it; judge it.
Follow $ROOT/references/verification.md, section 'Re-check rounds'. Scope: $scope.
Start with $J/$delta: it lists the open findings of round $((round - 1)), the scenes that changed since then (with their script sentences and claims) and the preview sheets that show them.
Re-check each open finding and every changed scene with all layers that apply (find source passages with grep in paper/paper.txt and open only the cited paper/pages/*.jpg; open only the listed build/preview_*.jpg). Do not re-verify scenes that did not change. An open finding about a scene that is not in the delta was not fixed: look that scene up in script.json / claims.json with grep and keep or update its row.
You may run: $ROOT/p2v check $job (it must be FAIL 0 WARN 0).
$J/$out is the previous report ($prev): edit it in place. Set the first line to 'round: $round (re-check)', update the rows you re-checked (fixed -> 'ok (fixed in round $round)'), add rows for new findings, keep the other rows as they are, and end with the new 'overall: PASS', 'overall: FIX-AND-RERUN' or 'overall: BLOCKED'. Do not edit any other file."
  fi
  if [ "$round" -gt 4 ]; then echo "p2v: round $round. SKILL.md allows 3 fix rounds: report BLOCKED with the open items instead of looping" >&2; fi
  echo "verify round $round ($mode), job $job, scope: $scope -> $J/$out${delta:+  (delta: $J/$delta)}"
  if [ -n "$brief" ]; then printf '%s\n' "$prompt"; return 0; fi   # brief for a verifier subagent (Claude Code)
  [ -n "$agent" ] && export P2V_AGENT="$agent"
  agent=$(pick_agent) || exit 1
  mkdir -p "$P2V_HOME/logs"
  agent_exec "$agent" "$J" "$prompt" "$P2V_HOME/logs/verify_${job}.r${round}.log"
}

scenes_cmd() {
  need_tools
  local agent="" scenes="" job="" file="" brief=""
  while [ $# -gt 0 ]; do case "$1" in
    --agent) agent="${2:-}"; shift 2 ;; --scenes) scenes="${2:-}"; shift 2 ;; --file) file="${2:-}"; shift 2 ;;
    --brief) brief=1; shift ;; *) job="$1"; shift ;; esac; done
  need_job "$job"
  [ -n "$scenes" ] && [ -n "$file" ] || { echo "usage: p2v scenes <job> --scenes a,b,c --file scenes_<chapter>.js [--agent claude|codex] [--brief]"; exit 2; }
  local J="$P2V_JOBS/$job" sb
  sb=$("$PY" "$ROOT/scripts/scene_brief.py" "$job" --scenes "$scenes" --file "$file") || exit 1
  # So this writer can preview before the other chapters exist: scenes.js re-exports this file, and every chapter file
  # it imports exists (empty until its writer fills it; preview --scenes draws placeholders for scenes without a factory).
  [ -f "$J/scenes.js" ] || printf '// One file per chapter (written by p2v scenes), re-exported here.\n' > "$J/scenes.js"
  grep -q "from './$file'" "$J/scenes.js" || printf "export * from './%s';\n" "$file" >> "$J/scenes.js"
  local f
  for f in $(grep -oE "from '\./[A-Za-z0-9_.-]+\.js'" "$J/scenes.js" | sed -E "s/from '\.\/(.*)'/\1/"); do
    [ -f "$J/$f" ] || printf '// Not written yet: p2v scenes fills this chapter.\nexport {};\n' > "$J/$f"
  done
  local prompt="You write the scene code for one chapter of the doc2course job in $J. Other chapters are written separately.
Read: $sb (sentences, timing, claims and BRIEF lines for your scenes), $ROOT/references/scene-authoring.md, and the job's helper files it names. Get the engine API from '$ROOT/p2v api' (or '$ROOT/p2v api <word>'); do not read the engine source.
Look only at the page images the brief cites (paper/pages/p-NNN.jpg) when a scene redraws a figure.
Write $J/$file with one exported factory per scene: $scenes. Import shared helpers from /engine/kit.js and the job's helper files; put helpers only this chapter needs in $file. Do not edit any other file; if a shared helper must change, say so in your answer.
Then run '$ROOT/p2v preview $job --scenes $scenes', open each sheet it wrote once, fix overflow, overlap, blank frames and text under the subtitle band, and re-preview only the scenes you changed. Run '$ROOT/p2v check $job' and fix numbers your scenes draw that it reports.
Answer in a few lines: scenes written, anything left open."
  if [ -n "$brief" ]; then printf '%s\n' "$prompt"; return 0; fi
  [ -n "$agent" ] && export P2V_AGENT="$agent"
  agent=$(pick_agent) || exit 1
  mkdir -p "$P2V_HOME/logs"
  echo "scene writer: $agent, job $job, $file <- $scenes"
  agent_exec "$agent" "$J" "$prompt" "$P2V_HOME/logs/scenes_${job}_${file%.js}.log"
}

run_unattended() {
  local agent=""
  [ "${1:-}" = "--agent" ] && { agent="${2:-}"; shift 2; }
  [ $# -ge 1 ] || { echo "usage: p2v run [--agent claude|codex] <arxiv link | file.pdf | pdf link> [overrides]"; exit 2; }
  need_tools
  [ -n "$agent" ] && export P2V_AGENT="$agent"
  agent=$(pick_agent) || exit 1
  local src="$1"; shift
  # Fetch here, outside the agent, so agent sandboxes without network (Codex by default) still work.
  local out; out=$("$PY" "$ROOT/scripts/fetch_paper.py" "$src") || { echo "$out"; exit 2; }
  echo "$out"
  local id; id=$(printf '%s' "$out" | "$SYSPY" -c "import json,re,sys; t=sys.stdin.read(); m=re.search(r'\{.*?\n\}', t, re.S); print(json.loads(m.group(0))['job'])") \
    || { echo "p2v: could not read the job id from the fetch output"; exit 2; }
  mkdir -p "$P2V_HOME/logs"; local log="$P2V_HOME/logs/$id.$agent.log"
  echo "doc2course: $id via $agent  (log: $log)"
  if [ "$agent" = claude ]; then
    agent_exec claude "$P2V_HOME" "/doc2course $id $*" "$log"
  else
    agent_exec codex "$P2V_HOME" "Make the doc2course explainer video for job '$id' (already fetched into $P2V_JOBS/$id). Overrides: ${*:-none}.
Read $ROOT/SKILL.md first and follow it from step 2; the skill folder is $ROOT and every command is $ROOT/p2v <subcommand>.
This is an unattended run: do not ask questions; stop only where SKILL.md says to stop." "$log"
  fi
}

CMD="${1:-help}"; shift || true
case "$CMD" in
  setup)   setup ;;
  doctor)  doctor ;;
  paths)   "$SYSPY" "$ROOT/scripts/p2v_paths.py" --shell ;;
  fetch)   need_tools; [ -n "${1:-}" ] || { echo "usage: p2v fetch <arxiv link or id | file.pdf | pdf link> [--job ID] [--type slides|paper|document] [--figures own|unknown]"; exit 2; }; exec "$PY" "$ROOT/scripts/fetch_paper.py" "$@" ;;
  check)   need_job "${1:-}"; need_tools; exec "$PY" "$ROOT/scripts/check_claims.py" "$@" ;;
  tts)     need_job "${1:-}"; need_tools; exec "$PY" "$ROOT/scripts/tts.py" "$@" ;;
  preview) need_job "${1:-}"; need_tools; exec node "$ROOT/scripts/render.mjs" "$@" --preview ;;
  render)  need_job "${1:-}"; need_tools; exec node "$ROOT/scripts/render.mjs" "$@" ;;
  scenes)  scenes_cmd "$@" ;;
  api)     exec "$SYSPY" "$ROOT/scripts/api.py" "$@" ;;
  verify)  verify "$@" ;;
  collect) exec node "$ROOT/scripts/collect.mjs" ;;
  gpus)    exec node -e 'import(process.argv[1]).then(m => console.log(m.formatGpus()))' "$ROOT/scripts/gpu.mjs" ;;
  smoke)   smoke "${1:-}" ;;
  test)    "$SYSPY" "$ROOT/tests/test_python.py" && node "$ROOT/tests/test_server.mjs" ;;
  run)     run_unattended "$@" ;;
  help|-h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "p2v: unknown command '$CMD' (try: p2v help)"; exit 2 ;;
esac
